<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Opening Snapchat...</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { background-color: #111111; color: #ffffff; font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .btn { background-color: #FFFC00; color: #000000; padding: 15px 40px; font-size: 16px; font-weight: bold; border: none; border-radius: 50px; text-decoration: none; cursor: pointer; }
    </style>
</head>
<body>
    <p>Redirecting to Snapchat...</p>
    <button onclick="openSnap()" class="btn">Tap to Open Snapchat</button>
    <script>
        const tg = window.Telegram.WebApp;
        tg.ready();
        tg.expand();
        function openSnap() {
            tg.openLink("https://www.snapchat.com", { tryInstantView: false });
            setTimeout(() => { tg.close(); }, 3000);
        }
        window.onload = function() { setTimeout(openSnap, 500); };
    </script>
</body>
</html>
