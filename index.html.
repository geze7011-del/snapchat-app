<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting...</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { background-color: #000000; color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; padding: 20px; box-sizing: border-box; }
        .card { text-align: center; background: #111111; padding: 30px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); width: 100%; max-width: 320px; }
        h2 { font-size: 22px; margin-bottom: 10px; font-weight: 600; }
        p { color: #aaaaaa; font-size: 14px; margin-bottom: 25px; }
        .btn { display: inline-block; background-color: #FFFC00; color: #000000; padding: 16px 0; width: 100%; font-size: 16px; font-weight: bold; border: none; border-radius: 50px; text-decoration: none; cursor: pointer; transition: transform 0.1s ease; width: 100%; text-align: center; }
        .btn:active { transform: scale(0.98); }
    </style>
</head>
<body>

    <div class="card">
        <h2>Snapchat Content</h2>
        <p>Tap below to redirect safely to the Snapchat application.</p>
        <button onclick="goToSnapchat()" class="btn">Continue to Snapchat</button>
    </div>

    <script>
        function goToSnapchat() {
            // Check if we are genuinely inside the Telegram App environment
            if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.platform !== 'unknown') {
                const tg = window.Telegram.WebApp;
                tg.ready();
                tg.expand();
                tg.openLink("https://www.snapchat.com", { tryInstantView: false });
                setTimeout(() => { tg.close(); }, 1000);
            } else {
                // If opened in a regular browser (Chrome, Safari, etc.), redirect directly
                window.location.href = "https://www.snapchat.com";
            }
        }

        // Attempt automatic routing immediately upon page load
        window.onload = function() {
            setTimeout(goToSnapchat, 500);
        };
    </script>
</body>
</html>
